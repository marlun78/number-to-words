{
    "env": {
        "browser": true,
        "node": true
    },
    "parserOptions": {
        "ecmaVersion": 5,
        "sourceType": "script"
    },
    "overrides": [
        {
            "files": ["playwright.config.js", "spec/playwright/**/*.js"],
            "parserOptions": {
                "ecmaVersion": 2018
            }
        }
    ]
}
