{
  "name": "number-to-words",
  "version": "1.2.5",
  "description": "Contains some util methods for converting numbers into words, ordinal words and ordinal numbers.",
  "keywords": [
    "converter",
    "number",
    "ordinal",
    "string",
    "tool",
    "word"
  ],
  "homepage": "https://github.com/marlun78/number-to-words",
  "bugs": {
    "url": "https://github.com/marlun78/number-to-words/issues"
  },
  "license": "MIT",
  "author": "Martin Eneqvist (https://github.com/marlun78)",
  "contributors": [
    "Aleksey Pilyugin (https://github.com/pilyugin)",
    "Jeremiah Hall (https://github.com/jeremiahrhall)",
    "Adriano Melo (https://github.com/adrianomelo)",
    "dmrzn (https://github.com/dmrzn)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marlun78/number-to-words.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/number-to-words.min.js",
  "jsdelivr": "./dist/number-to-words.min.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "npm run build && vitest run --project src --project esm --project cjs",
    "test:browser": "npm run build && vitest run --project iife --project iife-min",
    "test:smoke": "npm run build && node test/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@types/node": "24.19.0",
    "@vitest/browser-playwright": "5.0.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "1.63.0",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
