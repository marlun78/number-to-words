{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The specs import the public API by package name, Vitest points it at each build
    "paths": { "number-to-words": ["./src/index.ts"] }
  },
  "include": ["src/**/*.test.ts", "test", "*.config.ts"]
}
